{
    admin off
}

# ==============================================================================
# 1. Developer Documentation Portal
# ==============================================================================
docs.atekervoices.com {
    reverse_proxy phosai-docs:7970
}

# ==============================================================================
# 2. Unified Speech & AI Public API Gateway
# ==============================================================================
api.atekervoices.com {
    # Real-Time Streaming Audio WebSocket -> Remote STT Cluster
    @realtime path /v1/realtime*
    handle @realtime {
        reverse_proxy https://stt-staging.atekervoices.com {
            header_up Host stt-staging.atekervoices.com
            transport http {
                tls
                tls_server_name stt-staging.atekervoices.com
            }
        }
    }

    # Unified Metered AI Gateway (STT, TTS, Translation, API Keys, Billing) -> Studio API
    @gateway path /v1/transcribe* /v1/audio/transcriptions* /v1/audio/speech* /v1/translate* /translate* /v1/api-keys* /v1/billing* /api/*
    handle @gateway {
        reverse_proxy studio-api:8000
    }

    # Default fallback
    handle {
        reverse_proxy studio-api:8000
    }
}

# ==============================================================================
# 3. Studio Web Dashboard & Voice Agent OS
# ==============================================================================
atekervoices.com, www.atekervoices.com, http://agents.phosaico.com, https://agents.phosaico.com, :80, :443 {
    # 1. Rust Voice Server: WebSockets, WebRTC signaling & session endpoints
    @voice path /ws/* /voice/* /rtc/* /telephony/*
    handle @voice {
        reverse_proxy voice-server:8300
    }

    # 2. FastAPI Backend API
    @api path /api/* /v1/*
    handle @api {
        reverse_proxy studio-api:8000
    }

    # 3. Next.js Web Studio Frontend
    handle {
        reverse_proxy studio-web:3000
    }
}
