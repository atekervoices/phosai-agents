# Root .env — used by docker compose up -d
# Copy to .env and customise.
# Local development only. Used by docker compose variable substitution.
# Not used when running studio/api or voice/server directly.

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_PASSWORD=ferosdev
POSTGRES_DB=voice_agent

# ── Shared across services ───────────────────────────────────
# Must match between studio-api and voice-server.
AUTH__SECRET_KEY=change-me-in-production

# Override the full connection string (optional — built automatically
# from POSTGRES_PASSWORD and POSTGRES_DB when omitted).
# DATABASE__URL=postgresql://voice-agent-os:ferosdev@db:5432/voice_agent

# ── Service Endpoints ─────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.phosaico.com
VOICE_SERVER__PUBLIC_URL=https://voice.phosaico.com/
# TELNYX__PUBLIC_KEY=
# Enable experimental Telnyx support (studio-api / voice-server runtime flag)
# EXPERIMENTAL__TELNYX=false
# Enable the Telnyx UI in the Next.js frontend (studio/web build-time flag)
# NEXT_PUBLIC_EXPERIMENTAL_TELNYX=false

# ── Firebase Authentication ─────────────────────────────────────────
# Copy from agents-studio or Firebase Console (Project Settings -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Superadmin & Role Configuration
ADMIN_EMAIL=simonallanachuka@gmail.com
# Optional: path to Firebase service account json key file for backend Admin SDK
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/service-account.json
